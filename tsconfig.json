{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "jsx": "react-jsx",
    "strict": true, "noUncheckedIndexedAccess": true, "exactOptionalPropertyTypes": true,
    "allowImportingTsExtensions": true, "verbatimModuleSyntax": true, "erasableSyntaxOnly": true,
    "skipLibCheck": true, "noEmit": true, "types": ["node"]
  },
  "include": ["apps/desktop/src", "apps/desktop/vite.config.ts", "packages", "tests/*.ts"]
}
